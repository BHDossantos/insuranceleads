# Copy to .env and adjust.
# SQLite (default, zero-config). For PostgreSQL, set provider="postgresql" in
# prisma/schema.prisma and use a postgres:// URL here.
DATABASE_URL="file:./dev.db"

# Business agent (ported from Jennifer). Runs only from your computer with `npm run agent`; off unless true.
BUSINESS_AGENT_ENABLED=
ANTHROPIC_API_KEY=
# Optional model override.
BUSINESS_AGENT_MODEL=
