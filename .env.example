# Copy to .env and adjust.
# SQLite (default, zero-config). For PostgreSQL, set provider="postgresql" in
# prisma/schema.prisma and use a postgres:// URL here.
DATABASE_URL="file:./dev.db"

# Single trusted-operator pilot only. Private APIs/pages fail closed without
# both settings. Provision a >=32-character password through a secret manager;
# never use NEXT_PUBLIC_* or share it with agents/clients.
INSURANCE_OPERATOR_PASSWORD=""
# Exact HTTPS origin, no trailing slash. Local HTTP loopback is allowed only
# outside production. Validates browser write origins against CSRF.
INSURANCE_APP_ORIGIN=""

# Existing Twilio primary auth token, server-only. Never NEXT_PUBLIC_*.
TWILIO_AUTH_TOKEN=""
# Exact public HTTPS callback URL including query string, if configured.
# Path must be /api/webhooks/twilio/sms. Missing configuration fails closed.
TWILIO_SMS_WEBHOOK_URL=""
